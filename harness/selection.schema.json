{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career Ledger proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matches",
    "unmatched_requirements"
  ],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "evidence_id",
          "relationship"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unmatched_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
